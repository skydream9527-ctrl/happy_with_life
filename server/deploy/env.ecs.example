# 复制为仓库根目录 .env 后填写。不要提交真实 .env。
APP_ENV=staging
IMAGE_TAG=local

POSTGRES_PASSWORD=replace-with-strong-password
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_KEY_PREFIX=xqx:staging:

JWT_SIGNING_KEY=replace-with-at-least-32-character-secret
PHONE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PHONE_HASH_PEPPER=replace-with-long-random-pepper

# 短信签名未批下来之前，staging 可用 mock；prod 必须 aliyun。
SMS_PROVIDER=mock
SMS_DEV_CODE=123456
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
