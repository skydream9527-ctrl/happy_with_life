APP_ENV=dev
APP_VERSION=0.1.0
HTTP_ADDR=:8080
LOG_LEVEL=info

POSTGRES_DSN=postgres://xqx:change-me@127.0.0.1:5432/xiaoquexing?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=xqx:dev:

JWT_SIGNING_KEY=replace-with-at-least-32-character-secret
PHONE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PHONE_HASH_PEPPER=replace-with-long-random-pepper

SMS_PROVIDER=mock
SMS_DEV_CODE=123456
SMS_CODE_TTL=5m
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
HTTP_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=1048576
CORS_ORIGINS=
DEV_INMEMORY=false
RUN_MIGRATIONS=false

ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# 媒体：内测默认 mock（本机/ECS 磁盘）。接 OSS 后改 aliyun。
OSS_PROVIDER=mock
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
MEDIA_DATA_DIR=data/media
PUBLIC_BASE_URL=
MEDIA_QUOTA_BYTES=209715200
MEDIA_MAX_PHOTO_BYTES=5242880
ACCOUNT_DELETE_GRACE=24h
